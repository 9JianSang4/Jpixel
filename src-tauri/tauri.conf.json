{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "jpixel",
  "version": "0.1.0",
  "identifier": "com.tauri-app.jpixel",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "jpixel",
        "width": 800,
        "height": 600,
        "visible": false,
        "decorations": true,
        "fullscreen": false,
        "maximized": false,
        "maximizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$TEMP/jpixel/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
